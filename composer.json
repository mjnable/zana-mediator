{
    "name": "mj-zana/mediator",
    "description": "Commands and queries dispatched to handlers through pipeline behaviours (CQRS) for Zana applications",
    "type": "library",
    "keywords": ["zana", "mediator", "cqrs", "commands", "queries", "handlers"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Mediator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Mediator\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
