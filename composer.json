{
    "name": "zana/mediator",
    "description": "CQRS mediator for dispatching commands and queries in Zana applications",
    "type": "library",
    "keywords": ["zana", "mediator", "cqrs", "command", "query"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "zana/container": "^1.0",
        "zana/enterprise": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Mediator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Mediator\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

